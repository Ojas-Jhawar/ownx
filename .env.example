# Supabase — Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY= key

# Google Form for business applications (public link)
NEXT_PUBLIC_ORG_FORM_URL= form
# Link to the linked Google Sheet with responses (only admins see it on /admin)
NEXT_PUBLIC_ORG_FORM_RESPONSES_URL= form


# Anthropic — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional override, defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=claude-sonnet-5

# Base URL used to build shareable passport/listing links (no trailing slash)
# Locally: http://localhost:3000  |  On Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000




# Set to "true" to re-enable resale (marketplace + listing creation). Default off.
NEXT_PUBLIC_RESALE_ENABLED=false
# Optional salt for hashing IPs in the waitlist rate limiter
WAITLIST_SALT=change-me

# Optional: receives a reminder when scrap rates go stale
ADMIN_EMAIL=
